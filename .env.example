# هم‌ترازی با docker-compose.yml:
# مقادیر پیش‌فرض بعد از :- برای MONGO_DB / MONGO_COLLECTION / OPENROUTER_MODEL در compose
# باید با همین فایل یکسان باشد (الان یکسان است).
# فایل .env واقعی شما می‌تواند مقادیر متفاوت داشته باشد؛ فقط نام کلیدها را از این قالب بگیرید.

# --- MongoDB (REMOTE) ---
# Recommended format:
# mongodb://administrator:<PASSWORD>@144.172.92.16:27017/?authSource=admin
MONGO_URI=mongodb://administrator:CHANGE_ME@144.172.92.16:27017/?authSource=admin
MONGO_DB=test_telegram_db
MONGO_COLLECTION=message

# --- AI endpoint (OpenRouter or OpenAI-compatible server like Gama) ---
# OpenRouter:
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
# OPENROUTER_API_KEY=sk-or-v1-CHANGE_ME
#
# Gama / no-key compatible server:
# OPENROUTER_BASE_URL=http://gandolf-gama-46tarc-2120f0-144-172-94-6.sslip.io/v1/chat/completions
# OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_API_KEY=sk-or-v1-CHANGE_ME
# Free models (e.g. :free) often return HTTP 429 from the upstream provider — use more retries + longer
# rate-limit waits, switch to a paid model, or add your own provider key in OpenRouter settings.
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
# Comma-separated fallback models to try immediately when the main model hits quota/rate limits.
OPENROUTER_FALLBACK_MODELS=
# Omit by default. Use `on` for models that require reasoning (e.g. openai/gpt-oss-20b). Use `off` only if the model supports disabling it.
# OPENROUTER_REASONING=on

# --- Worker tuning ---
BATCH_SIZE=25
SLEEP_SECONDS=60.0
IDLE_SLEEP_SECONDS=2.0
IDLE_LOG_INTERVAL_SECONDS=30
OPENROUTER_TIMEOUT_SECONDS=60
OPENROUTER_MAX_RETRIES=6
OPENROUTER_BACKOFF_SECONDS=2.0
# Seconds to wait between retries on HTTP 429 when Retry-After header is absent (default 45).
OPENROUTER_RATE_LIMIT_BACKOFF_SECONDS=45
# Worker pause after quota/free-model daily-limit errors when no fallback succeeds.
OPENROUTER_QUOTA_COOLDOWN_SECONDS=5
DEBUG_WORKER=0

# If you run multiple replicas, set a unique token per instance
# WORKER_TOKEN=worker-1
